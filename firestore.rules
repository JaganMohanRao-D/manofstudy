rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Test collection for connection validation
    match /test/{docId} {
      allow read, write: if true;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(authorUid) {
      return isAuthenticated() && request.auth.uid == authorUid;
    }

    function isNotSpoofingAdmin() {
      return !('isAdmin' in request.resource.data && request.resource.data.isAdmin == true)
        && request.resource.data.authorName != 'Man of Study Admin';
    }

    // Campus Posts (Doubts & Dispatches)
    match /campus_posts/{postId} {
      // Browsing is public for all students
      allow read: if true;

      // Creation requires REAL Firebase Authentication
      allow create: if isAuthenticated()
        && request.resource.data.authorUid == request.auth.uid
        && isNotSpoofingAdmin();

      // Updates: Upvotes allowed for anyone/peers; Content edit restricted strictly to author
      allow update: if (
          // Upvoting (only upvotes counter changes)
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes'])
        ) || (
          // Author modifying own post
          isOwner(resource.data.authorUid)
          && request.resource.data.authorUid == resource.data.authorUid
          && isNotSpoofingAdmin()
        );

      // Deletions strictly restricted to author
      allow delete: if isOwner(resource.data.authorUid);

      // Nested Replies & Solutions
      match /replies/{replyId} {
        allow read: if true;

        // Solution posting requires REAL Firebase Authentication
        allow create: if isAuthenticated()
          && request.resource.data.authorUid == request.auth.uid
          && isNotSpoofingAdmin();

        // Solution updates: upvoting, or author edit
        allow update: if (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes'])
          ) || (
            isOwner(resource.data.authorUid)
            && request.resource.data.authorUid == resource.data.authorUid
            && isNotSpoofingAdmin()
          );

        allow delete: if isOwner(resource.data.authorUid);
      }
    }

    // User Profiles (Private account & notification preferences)
    // Mathematical zero-trust: Only the authenticated account owner can view or edit their profile
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // In-App Notifications Collection
    match /notifications/{notificationId} {
      // Recipient can read their own notifications
      allow read: if isAuthenticated();

      // Authenticated users can create notifications when submitting an answer
      allow create: if isAuthenticated();

      // Recipient can update (mark as read)
      allow update: if isAuthenticated();

      // Recipient can delete
      allow delete: if isAuthenticated();
    }

    // Mail Collection (For Firebase Trigger Email extension)
    // Crucial anti-abuse: Disallow direct client creation to prevent arbitrary spam.
    // Read is only permitted for the recipient question owner.
    match /mail/{notificationId} {
      allow read: if isAuthenticated() && (
        ('toUids' in resource.data && request.auth.uid in resource.data.toUids) ||
        ('recipientUid' in resource.data && request.auth.uid == resource.data.recipientUid)
      );
      // Writes are strictly restricted to trusted backend server / Cloud Functions
      allow write: if false;
    }
  }
}
