{
  "entities": {
    "CampusPost": {
      "title": "CampusPost",
      "description": "Student doubt or campus dispatch in MOS CampusConnect",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the post"
        },
        "authorUid": {
          "type": "string",
          "description": "Authenticated Firebase UID of the author"
        },
        "authorName": {
          "type": "string",
          "description": "Public author display name (Anonymous Student or Real Name)"
        },
        "displayName": {
          "type": "string",
          "description": "Authenticated Google display name"
        },
        "isAnonymous": {
          "type": "boolean",
          "description": "Whether the post author opted for public anonymity"
        },
        "title": {
          "type": "string",
          "description": "Title or summary of the doubt/dispatch"
        },
        "content": {
          "type": "string",
          "description": "Detailed text of the doubt or query"
        },
        "college": {
          "type": "string",
          "description": "College name of the author"
        },
        "branch": {
          "type": "string",
          "description": "Academic branch/major"
        },
        "type": {
          "type": "string",
          "description": "Category of post: doubt or dispatch",
          "enum": ["doubt", "dispatch"]
        },
        "urgency": {
          "type": "string",
          "description": "Urgency level e.g. Casual, Mid Exams Near, Sem Exams Near"
        },
        "codeSnippet": {
          "type": "string",
          "description": "Optional code or math snippet"
        },
        "upvotes": {
          "type": "number",
          "description": "Total upvotes count"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        }
      },
      "required": ["id", "authorUid", "authorName", "isAnonymous", "title", "content", "createdAt"]
    },
    "CampusReply": {
      "title": "CampusReply",
      "description": "Peer answer or solution to a CampusConnect doubt",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the reply"
        },
        "postId": {
          "type": "string",
          "description": "ID of parent doubt post"
        },
        "authorUid": {
          "type": "string",
          "description": "Authenticated Firebase UID of the peer"
        },
        "authorName": {
          "type": "string",
          "description": "Public author display name (Anonymous Student, Real Name, or Admin)"
        },
        "displayName": {
          "type": "string",
          "description": "Authenticated Google display name"
        },
        "isAnonymous": {
          "type": "boolean",
          "description": "Whether the solution author opted for public anonymity"
        },
        "content": {
          "type": "string",
          "description": "Explanation, answer or solution text"
        },
        "college": {
          "type": "string",
          "description": "College of the student"
        },
        "role": {
          "type": "string",
          "description": "Year or student status description"
        },
        "upvotes": {
          "type": "number",
          "description": "Upvotes on this solution"
        },
        "isVerifiedSolution": {
          "type": "boolean",
          "description": "Flag for verified solutions"
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Flag for official admin announcement"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        }
      },
      "required": ["id", "authorUid", "authorName", "isAnonymous", "content", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated student user account profile and notification preferences",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "Verified Google email address"
        },
        "displayName": {
          "type": "string",
          "description": "Google display name"
        },
        "photoURL": {
          "type": "string",
          "description": "Optional Google avatar URL"
        },
        "emailNotificationsEnabled": {
          "type": "boolean",
          "description": "Whether the user wishes to receive email alerts when someone answers their doubt"
        },
        "solutionsCount": {
          "type": "number",
          "description": "Number of helpful solutions submitted by this student"
        },
        "totalReports": {
          "type": "number",
          "description": "Total community violation reports accumulated by this user"
        },
        "isBanned": {
          "type": "boolean",
          "description": "Flag indicating if the user account is suspended due to violations"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["uid", "email", "emailNotificationsEnabled", "updatedAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Community moderation flag for inappropriate post or reply",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique report ID"
        },
        "targetType": {
          "type": "string",
          "description": "Type of target: post or reply",
          "enum": ["post", "reply"]
        },
        "targetId": {
          "type": "string",
          "description": "ID of post or reply reported"
        },
        "postId": {
          "type": "string",
          "description": "Associated post ID"
        },
        "authorUid": {
          "type": "string",
          "description": "UID of the content author being reported"
        },
        "reason": {
          "type": "string",
          "description": "Violation category"
        },
        "reporterUid": {
          "type": "string",
          "description": "UID of the user filing the report"
        },
        "reporterEmail": {
          "type": "string",
          "description": "Email of reporter"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of report"
        }
      },
      "required": ["targetType", "targetId", "reason", "reporterUid"]
    },
    "MailNotification": {
      "title": "MailNotification",
      "description": "Email notification document for Firebase Trigger Email extension and backend dispatcher",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Deterministic notification ID: answer_notification_{postId}_{replyId}"
        },
        "to": {
          "type": "string",
          "description": "Recipient email address of the question owner"
        },
        "toUids": {
          "type": "string",
          "description": "Firebase UID of recipient question owner"
        },
        "postId": {
          "type": "string",
          "description": "ID of the answered question"
        },
        "replyId": {
          "type": "string",
          "description": "ID of the answer"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        }
      },
      "required": ["to", "postId", "replyId", "createdAt"]
    },
    "CampusNotification": {
      "title": "CampusNotification",
      "description": "In-app real-time notification for student question replies",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the notification"
        },
        "recipientEmail": {
          "type": "string",
          "description": "Email of the student who posted the question"
        },
        "senderName": {
          "type": "string",
          "description": "Name of the user who answered"
        },
        "questionId": {
          "type": "string",
          "description": "ID of the post"
        },
        "questionTitle": {
          "type": "string",
          "description": "Title of the question"
        },
        "replySnippet": {
          "type": "string",
          "description": "First 80 chars of the answer"
        },
        "createdAt": {
          "type": "string",
          "description": "Firestore serverTimestamp or ISO string"
        },
        "isRead": {
          "type": "boolean",
          "description": "Read status of notification"
        }
      },
      "required": ["recipientEmail", "senderName", "questionId", "questionTitle", "replySnippet", "isRead"]
    }
  },
  "firestore": {
    "/campus_posts/{postId}": {
      "schema": "CampusPost",
      "description": "Collection of student doubt dispatches and questions"
    },
    "/campus_posts/{postId}/replies/{replyId}": {
      "schema": "CampusReply",
      "description": "Collection of peer solutions and comments"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profile and email notification preference document"
    },
    "/mail/{notificationId}": {
      "schema": "MailNotification",
      "description": "Transactional mail queue for Firebase Trigger Email extension"
    },
    "/notifications/{notificationId}": {
      "schema": "CampusNotification",
      "description": "In-app notifications for question answers"
    },
    "/posts/{postId}": {
      "schema": "CampusPost",
      "description": "Primary posts collection for doubts and questions"
    },
    "/posts/{postId}/replies/{replyId}": {
      "schema": "CampusReply",
      "description": "Subcollection of replies and solutions"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Community abuse and guideline violation reports"
    }
  }
}
