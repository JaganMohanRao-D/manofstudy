rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // CampusConnect peer attachments are scoped to the authenticated owner path.
    // Reads require sign-in so attachment URLs cannot be used as an anonymous
    // public data bucket. Create/delete remain limited to the owning UID.
    match /campusconnect/{userId}/{postId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/(jpeg|png|webp))');
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }


    // Public CMS media: public read is needed for published website images.
    // Only the verified owner account can upload/delete; SVG and executable
    // content are intentionally not accepted.
    match /public/cms-media/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.token.email == "jaganmakes@gmail.com"
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == "password"
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches("image/(jpeg|png|webp|gif)");
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.token.email == "jaganmakes@gmail.com"
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == "password";
    }

    // Default deny for all other storage paths.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
